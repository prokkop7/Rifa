DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
PORT=3000
APP_ORIGIN=http://localhost:5500
ADMIN_API_KEY=replace-with-long-random-secret-32-chars

# Asaas Sandbox (somente no servidor, nunca no GitHub)
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Base HTTPS para callbacks de pedidos comerciais independentes (sandbox)
COMMERCIAL_CHECKOUT_RETURN_BASE=https://seudominio.example
